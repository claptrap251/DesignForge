# Encryption key for tokens stored in the database.
# Falls back to NEXTAUTH_SECRET if not set.
# ENCRYPTION_KEY="your-random-secret-key"

DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="change-me-to-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
UPLOAD_DIR="./uploads"
NEXT_TELEMETRY_DISABLED=1

# Optional: set a base path to serve the app under a sub-path (e.g. "/design")
# Must start with "/" and have no trailing slash. Requires rebuild after changing.
# NEXT_PUBLIC_BASE_PATH="/design"

# Optional: comma-separated list of allowed dev origins for remote access
# ALLOWED_DEV_ORIGINS="192.168.1.100,10.0.0.5"

# Admin user (username that has access to backup/restore)
# ADMIN_USERNAME="admin"

# Enable semantic embeddings for document similarity (uses all-MiniLM-L6-v2 locally)
# Improves relationship detection but adds ~2s per document on first load
# SIMILARITY_USE_EMBEDDINGS="true"

# GitHub backup configuration
# GITHUB_BACKUP_URL="https://api.github.com"
# GITHUB_BACKUP_REPO="owner/repo-name"
# GITHUB_BACKUP_TOKEN="ghp_xxxx"
# GITHUB_BACKUP_BRANCH="main"
# BACKUP_SCHEDULE_CRON="0 2 * * *"
